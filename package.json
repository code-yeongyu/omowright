{
  "name": "omowright",
  "version": "0.0.1",
  "type": "module",
  "description": "OmOWright browser automation for standard Chromium CDP endpoints.",
  "license": "MIT",
  "keywords": [
    "browser-automation",
    "cdp",
    "chrome-devtools-protocol",
    "chromium",
    "ai-agent",
    "accessibility-snapshot",
    "llm",
    "bun"
  ],
  "homepage": "https://github.com/code-yeongyu/omowright#readme",
  "bugs": {
    "url": "https://github.com/code-yeongyu/omowright/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-yeongyu/omowright.git"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4"
  },
  "bin": {
    "omowright-cloak": "./bin/omowright-cloak.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:cloak-profile": "bun test test/cloak-profile.test.ts test/cloak-profile.integration.test.ts",
    "check": "bun x tsc --noEmit -p tsconfig.json",
    "lint": "bun x oxlint --deny-warnings src bin bridge test",
    "lint:fix": "bun x oxlint --fix src bin bridge test",
    "format": "bun x oxfmt --write src bin bridge test",
    "format:check": "bun x oxfmt --check src bin bridge test",
    "verify": "bun run check && bun run lint && bun run format:check",
    "build:extension": "bun bridge/build-extension.ts",
    "build": "bun build.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "acorn": "8.15.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  }
}
