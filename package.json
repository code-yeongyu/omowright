{
  "name": "omowright",
  "version": "0.2.0",
  "description": "OmOWright browser automation for standard Chromium CDP endpoints.",
  "keywords": [
    "accessibility-snapshot",
    "ai-agent",
    "browser-automation",
    "bun",
    "cdp",
    "chrome-devtools-protocol",
    "chromium",
    "llm"
  ],
  "homepage": "https://github.com/code-yeongyu/omowright#readme",
  "bugs": {
    "url": "https://github.com/code-yeongyu/omowright/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-yeongyu/omowright.git"
  },
  "bin": {
    "omowright-cloak": "./dist/bin/omowright-cloak.js"
  },
  "files": [
    "dist/",
    "skills/",
    "presets/",
    "README.md",
    "LICENSE",
    "TOOLS.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "bun test",
    "test:node": "node --test test/*.test.ts",
    "test:cloak-profile": "bun test test/cloak-profile.test.ts test/cloak-profile.integration.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:control": "bun scripts/typecheck-control.ts",
    "check": "bun run typecheck:control && bun run typecheck && bun run lint && bun run fmt:check",
    "lint": "oxlint --deny-warnings src bin bridge test scripts",
    "lint:fix": "oxlint --fix src bin bridge test scripts",
    "fmt": "oxfmt --write src bin bridge test scripts",
    "fmt:check": "oxfmt --check src bin bridge test scripts",
    "format": "bun run fmt",
    "format:check": "bun run fmt:check",
    "verify": "bun run check",
    "build": "bun build.ts",
    "build:extension": "bun bridge/build-extension.ts",
    "prepack": "bun run build",
    "preversion": "git diff --quiet HEAD --"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "acorn": "8.15.0",
    "gpt-tokenizer": "4.1.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "typescript-5": "npm:typescript@5.9.3"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=22"
  }
}
